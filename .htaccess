# Adilson Madoglio - Hostinger LiteSpeed configuration (.htaccess)
DirectoryIndex index.html
Options -Indexes
RewriteEngine On

# ---- HTTPS ----
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ---- Never expose dev / git / sensitive files ----
RedirectMatch 404 /\.git
<FilesMatch "^(\.gitignore|README\.md|package(-lock)?\.json)$">
  Require all denied
</FilesMatch>

# ---- URLs antigas (inglês) -> novas (português), 301 ----
RedirectMatch 301 ^/about/?$ /sobre
RedirectMatch 301 ^/team/?$ /equipe
RedirectMatch 301 ^/contact/?$ /contato
RedirectMatch 301 ^/news/?$ /blog
RedirectMatch 301 ^/services/?$ /servicos
RedirectMatch 301 ^/services/rooftop-solar-installation/?$ /servicos/instalacao-eletrica-residencial
RedirectMatch 301 ^/services/solar-system-maintenance/?$ /servicos/manutencao-eletrica-preventiva
RedirectMatch 301 ^/services/off-grid-solar-solutions/?$ /servicos/quadros-e-protecao-eletrica
RedirectMatch 301 ^/services/solar-panel-cleaning/?$ /servicos/iluminacao-e-tomadas
RedirectMatch 301 ^/services/inverter-repair-support/?$ /servicos/reparos-e-emergencias-eletricas
RedirectMatch 301 ^/services/battery-storage-solutions/?$ /servicos/carregador-de-carro-eletrico
RedirectMatch 301 ^/news/homeowners-guide-to-planning-rooftop-solar/?$ /blog/como-planejar-a-instalacao-eletrica-da-sua-casa
RedirectMatch 301 ^/news/solar-battery-storage-what-to-know/?$ /blog/disjuntor-desarmando-o-que-fazer
RedirectMatch 301 ^/news/simple-ways-to-care-for-your-solar-panels/?$ /blog/cuidados-para-manter-a-instalacao-eletrica-segura
RedirectMatch 301 ^/news/on-grid-vs-off-grid-solar/?$ /blog/dr-e-dps-qual-e-a-diferenca
RedirectMatch 301 ^/news/how-to-read-your-solar-system-performance/?$ /blog/como-ler-a-conta-de-luz

# ---- Canonical URLs: no /index.html and no .html ----
RewriteCond %{THE_REQUEST} \s/(.*)index\.html[\s?] [NC]
RewriteRule ^(.*)index\.html$ /$1 [R=301,L,NC]
RewriteCond %{THE_REQUEST} \s/(.+)\.html[\s?] [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NC]

# ---- Clean URLs: /about -> about.html ----
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L,QSA]

# Trailing slash for real directories
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

ErrorDocument 404 /404.html

# ---- Security headers ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ---- MIME types ----
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
  AddType image/svg+xml .svg
  AddType image/webp .webp
</IfModule>

# ---- Browser Caching ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
